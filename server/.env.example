# 관리자 계정 (서버를 처음 켤 때 자동 생성됩니다)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=바꿔주세요abc123

# Claude API 키
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# 이메일 발송 (Gmail 앱 비밀번호 방식). 비워 두면 인증 코드가 서버 화면(콘솔)에만 출력됩니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 선택: 비워 두면 data/jwt.secret 파일을 자동 생성해 사용합니다.
JWT_SECRET=
