# 관리자 계정 (서버를 처음 켤 때 자동 생성됩니다)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=바꿔주세요abc123

# 답변 모델 선택: ollama(로컬, 무료) 또는 claude(유료, API 키 필요). 바꾼 뒤 서버를 다시 켜세요.
LLM_PROVIDER=ollama

# Ollama(로컬 LLM) 설정
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=300

# Claude 설정 (LLM_PROVIDER=claude일 때만 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# 선택: 질문 하나에 보내는 근거 페이지 수 / 페이지당 글자 수. 비워 두면 ollama 3/2500, claude 6/4000
TOP_K=
PAGE_CHARS=

# 이메일 발송 (Gmail 앱 비밀번호 방식). 비워 두면 인증 코드가 서버 화면(콘솔)에만 출력됩니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 선택: 비워 두면 data/jwt.secret 파일을 자동 생성해 사용합니다.
JWT_SECRET=
