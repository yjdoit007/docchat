# 관리자 계정 (서버를 처음 켤 때 자동 생성됩니다)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=바꿔주세요abc123

# 답변 모드 기본값: ollama(로컬·무료·느림) / gemini(빠름·무료 등급·외부 전송) / claude(유료).
# 처음 기본값일 뿐이고, 실제 허용·기본 모드는 관리자 화면 > 서버 설정 > 답변 모델에서 바꿉니다.
LLM_PROVIDER=ollama

# Gemini (Google AI Studio에서 직접 발급: https://aistudio.google.com/apikey). 키가 있어야 Gemini 모드를 쓸 수 있습니다.
# 키는 비밀번호처럼 다루세요. 모델 이름을 비워 두면 gemini-flash-latest (가장 최근 Flash 모델)
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama(로컬 LLM) 설정
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=300

# Claude 설정 (LLM_PROVIDER=claude일 때만 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# 선택: 질문 하나에 보내는 근거 조문 수 / 조문당 최대 글자 수. 비워 두면 ollama 4/1500, claude 8/4000
TOP_K=
CHUNK_CHARS=

# 이메일 발송 (Gmail 앱 비밀번호 방식). 비워 두면 인증 코드가 서버 화면(콘솔)에만 출력됩니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 선택: 비워 두면 data/jwt.secret 파일을 자동 생성해 사용합니다.
JWT_SECRET=

# 외부 접속: DuckDNS 무료 도메인 (duckdns.org에서 직접 가입 후 입력). 비워 두면 주소 자동 갱신을 하지 않습니다.
# DUCKDNS_DOMAIN에는 앞부분만 (예: myteam → myteam.duckdns.org). 토큰은 비밀번호처럼 다루세요.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# API 시험 화면(/docs). 외부에 공개하면 0으로 끄세요.
API_DOCS=1
